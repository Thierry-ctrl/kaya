# TEMPLATE ONLY. Configure real values on AWS, never commit them.
NODE_ENV=production
PORT=3001
HOST=127.0.0.1
TRUST_PROXY=1
APP_ORIGIN=https://foods.example.com
DATABASE_URL=postgresql://kaya:REPLACE_PASSWORD@REPLACE_RDS_HOST:5432/kaya
DB_SSL=true
DB_CA_CERT_PATH=/etc/kaya/rds-ca.pem
CLERK_SECRET_KEY=REPLACE_WITH_EXTERNAL_CLERK_PRODUCTION_SECRET_KEY
CLERK_PUBLISHABLE_KEY=REPLACE_WITH_EXTERNAL_CLERK_PRODUCTION_PUBLISHABLE_KEY
STORAGE_PROVIDER=s3
S3_BUCKET=REPLACE_PRIVATE_BUCKET
S3_PREFIX=kaya
AWS_REGION=eu-west-1
# EC2 instance IAM role supplies AWS credentials. Do not set static access keys.
# External Clerk uses its configured custom auth domain, not the Replit proxy.